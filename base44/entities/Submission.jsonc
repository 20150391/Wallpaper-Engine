{
  "name": "Submission",
  "type": "object",
  "title": "Submission",
  "properties": {
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "title": "Type"
    },
    "family": {
      "type": "string",
      "title": "Family"
    },
    "color": {
      "type": "string",
      "title": "Color"
    },
    "image": {
      "type": "string",
      "title": "Image URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "posted_by": {
      "type": "string",
      "title": "Posted by"
    },
    "forked": {
      "type": "boolean",
      "default": false,
      "title": "Forked"
    },
    "fork_of": {
      "type": "string",
      "title": "Fork of"
    }
  },
  "required": [
    "slug",
    "title",
    "image"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}